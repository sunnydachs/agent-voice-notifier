{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-voice-notifier --hook",
            "timeout": 180
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-voice-notifier --hook",
            "timeout": 180
          }
        ]
      }
    ],
    "PostModelRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-voice-notifier --hook",
            "timeout": 180
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-voice-notifier --hook",
            "timeout": 180
          }
        ],
        "matcher": "Bash"
      }
    ]
  }
}
