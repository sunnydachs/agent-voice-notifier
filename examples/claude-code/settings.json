{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-voice-notifier --hook",
            "timeout": 180
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-voice-notifier --hook",
            "timeout": 180
          }
        ],
        "matcher": "permission_prompt"
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-voice-notifier --hook",
            "timeout": 180
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-voice-notifier --hook",
            "timeout": 180
          }
        ],
        "matcher": "Bash|PowerShell"
      }
    ]
  }
}
